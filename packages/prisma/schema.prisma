generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConsentStatus {
  pending
  opted_in
  opted_out
}

enum ReminderStatus {
  pending
  sent
  confirmed
  missed
  failed
}

enum ConsumptionStatus {
  taken
  skipped
  missed
}

enum ConsumptionSource {
  button
  free_text
  system_missed
}

enum TemplateType {
  enrollment
  reminder
  optin_confirm
  usage_hint
  already_opted_in
  confirmation
}

enum AdminRole {
  superadmin
}

enum BlastStatus {
  draft
  sending
  sent
  cancelled
}

enum BlastRecipientStatus {
  pending
  sent
  failed
}

enum TreatmentStatus {
  active
  completed
  dropped_out
}

enum OutboundKind {
  opt_in
  reminder
  usage_hint
  opt_in_confirm
  blast
}

enum OutboundStatus {
  pending
  sent
  failed
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(superadmin)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  patients Patient[]
  blasts   Blast[]

  @@map("admins")
}

model Patient {
  id            String        @id @default(cuid())
  name          String
  waNumber      String        @unique @map("wa_number")
  lid           String?
  enrollmentToken String? @unique @map("enrollment_token")
  dob           DateTime?
  consentStatus ConsentStatus @default(pending) @map("consent_status")
  consentAt     DateTime?     @map("consent_at")
  active        Boolean       @default(true)
  treatmentStatus TreatmentStatus @default(active) @map("treatment_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")
  createdById   String        @map("created_by_id")

  createdBy          Admin              @relation(fields: [createdById], references: [id])
  patientMedications PatientMedication[]
  reminders          Reminder[]
  consumptionLogs    ConsumptionLog[]
  outboundMessages   OutboundMessage[]
  blastRecipients    BlastRecipient[]

  @@index([consentStatus])
  @@index([active])
  @@map("patients")
}

model Medication {
  id          String   @id @default(cuid())
  name        String
  dosage      String
  unit        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  createdById String   @map("created_by_id")

  patientMedications PatientMedication[]

  @@map("medications")
}

model PatientMedication {
  id            String   @id @default(cuid())
  patientId     String   @map("patient_id")
  medicationId  String   @map("medication_id")
  scheduleTimes String[] @map("schedule_times")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  createdById   String   @map("created_by_id")

  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medication      Medication       @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  reminders       Reminder[]
  consumptionLogs ConsumptionLog[]

  @@index([patientId])
  @@index([medicationId])
  @@map("patient_medications")
}

model Reminder {
  id                  String         @id @default(cuid())
  patientId           String         @map("patient_id")
  patientMedicationId String         @map("patient_medication_id")
  scheduledAt         DateTime       @map("scheduled_at")
  status              ReminderStatus @default(pending)
  sentAt              DateTime?      @map("sent_at")
  wahaMessageId       String?        @map("waha_message_id")
  manual              Boolean        @default(false) @map("manual")
  retryCount          Int            @default(0) @map("retry_count")
  nextRetryAt         DateTime?      @map("next_retry_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")
  createdById         String         @default("SYSTEM") @map("created_by_id")

  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientMedication PatientMedication @relation(fields: [patientMedicationId], references: [id], onDelete: Cascade)
  consumptionLogs  ConsumptionLog[]

  @@index([patientId, scheduledAt, status])
  @@index([patientMedicationId, scheduledAt])
  @@index([status])
  @@map("reminders")
}

model ConsumptionLog {
  id                  String            @id @default(cuid())
  patientId           String?           @map("patient_id")
  patientMedicationId String?           @map("patient_medication_id")
  reminderId          String?           @map("reminder_id")
  status              ConsumptionStatus
  source              ConsumptionSource
  rawText             String?           @map("raw_text")
  reportedAt          DateTime          @default(now()) @map("reported_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  createdById         String            @default("SYSTEM") @map("created_by_id")

  patient          Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientMedication PatientMedication? @relation(fields: [patientMedicationId], references: [id], onDelete: SetNull)
  reminder         Reminder?         @relation(fields: [reminderId], references: [id])

  @@index([patientId])
  @@index([patientMedicationId])
  @@index([reminderId])
  @@map("consumption_logs")
}

model TemplateMessage {
  id           String       @id @default(cuid())
  type         TemplateType
  key          String       @unique
  title        String
  body         String
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")
  createdById  String       @default("SYSTEM") @map("created_by_id")

  @@map("template_messages")
}

model OutboundMessage {
  id            String         @id @default(cuid())
  patientId     String         @map("patient_id")
  kind          OutboundKind
  payload       Json
  wahaMessageId String?        @map("waha_message_id")
  status        OutboundStatus @default(pending)
  error         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  createdById   String         @default("SYSTEM") @map("created_by_id")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("outbound_messages")
}

model Blast {
  id              String      @id @default(cuid())
  title           String
  body            String
  mediaUrl        String?     @map("media_url")
  mediaType       String?     @map("media_type")
  status          BlastStatus @default(draft)
  scheduledAt     DateTime?   @map("scheduled_at")
  sentAt          DateTime?   @map("sent_at")
  totalRecipients Int         @default(0) @map("total_recipients")
  successCount    Int         @default(0) @map("success_count")
  failCount       Int         @default(0) @map("fail_count")
  createdById     String      @map("created_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")

  recipients BlastRecipient[]
  createdBy  Admin            @relation(fields: [createdById], references: [id])

  @@map("blasts")
}

model BlastRecipient {
  id            String                @id @default(cuid())
  blastId       String                @map("blast_id")
  patientId     String                @map("patient_id")
  patientName   String                @map("patient_name")
  waNumber      String                @map("wa_number")
  status        BlastRecipientStatus  @default(pending)
  wahaMessageId String?               @map("waha_message_id")
  error         String?
  sentAt        DateTime?             @map("sent_at")
  createdAt     DateTime              @default(now()) @map("created_at")

  blast   Blast   @relation(fields: [blastId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([blastId])
  @@index([patientId])
  @@map("blast_recipients")
}

model GeneralParameter {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("general_parameters")
}
